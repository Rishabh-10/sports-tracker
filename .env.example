# Copy this file to .env and fill in the keys you have.

# Football fixtures and results: free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Gemini, for the Ask page and news briefings: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which model to use (default gemini-flash-latest). The Flash-Lite alias has
# higher free-tier limits if you hit the daily cap.
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional: where the SQLite database lives (defaults to ./data)
# SPORTS_INFO_DATA_DIR=
